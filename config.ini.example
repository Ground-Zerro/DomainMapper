[DomainMapper]
# Локальный режим загрузки (yes/no)
localplatform = no
localdns = no

# Сервисы для проверки через запятую, без учета регистра (например: all, youtube, google, telegram, custom)
service =

# Список DNS серверов по номерам через пробел (0 - все, 1 - системный, 2 - google, 3 - quad9 и т.д.)
dnsserver =

# Исключить Cloudflare IP (yes/no)
cloudflare =

# Агрегация подсетей (16, 24, mix, no)
subnet =

# Имя выходного файла
filename = domain-ip-resolve.txt

# Максимум запросов в секунду к одному DNS серверу (по умолчанию 100).
# При таймаутах частота к этому серверу снижается автоматически и затем восстанавливается.
rate_limit = 100

# Максимум запросов в секунду ко всем DNS серверам вместе (по умолчанию 200).
# Ограничивает общую нагрузку на сеть: превышение приводит к потере запросов роутером или провайдером.
total_rate_limit = 200

# Формат результата (ip, win, unix, keenetic bat, keenetic cli, cidr, mikrotik, ovpn, wireguard)
filetype =

# Параметры для форматов:
## для win/unix — IP шлюза или имя интерфейса
gateway =
## для keenetic cli — IP шлюза или имя интерфейса, можно оба через пробел
keenetic =
## для mikrotik — имя списка address-list
listname =
## для mikrotik - добавить или убирать "comment=%SERVICE_NAME%" в правилах Mikrotik (on/off)
mk_comment = off

# Показывать конфигурацию при запуске (yes/no)
cfginfo = yes

# Выполнить команду или запустить приложение после завершения (команда/полный путь к приложению)
run =
